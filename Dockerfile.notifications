FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache openssl
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --omit=dev && npx prisma generate
COPY scripts/notification-worker.mjs ./scripts/notification-worker.mjs
COPY lib/notifications ./lib/notifications
USER node
CMD ["node", "scripts/notification-worker.mjs"]

